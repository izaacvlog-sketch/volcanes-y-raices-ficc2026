{
  "cleanUrls": true,
  "redirects": [
    { "source": "/grano-de-oro", "destination": "/ficc-2026#grano-de-oro", "permanent": true },
    { "source": "/ficc", "destination": "/ficc-2026", "permanent": true },
    { "source": "/revista", "destination": "/revista-volcanes-y-raices", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
